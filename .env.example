# Copy this file to .env and fill in your real secrets.
# Do not paste secrets into chat.

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Optional. If empty, the bot uses extractive knowledge-base replies only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Knowledge folder relative to this project folder.
KNOWLEDGE_DIR=output/coze_upload

# Bot behavior
MAX_CONTEXT_CHARS=9000
MAX_LINE_REPLY_CHARS=4500
